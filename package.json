{
  "name": "wat-word-ik",
  "version": "0.0.0",
  "private": true,
  "description": "Drag your school grades, see which professions open up.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "check:dist": "node scripts/check-dist.mjs dist package-lock.json",
    "check:lock": "node scripts/check-lockfile.mjs package-lock.json",
    "check:commits": "node scripts/check-commits.mjs",
    "check:links": "node scripts/check-links.mjs",
    "check:tree": "node scripts/check-tree.mjs",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@preact/signals": "2.11.4",
    "preact": "11.1.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
